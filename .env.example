# Database
DATABASE_URL=postgresql+asyncpg://agentos:agentos_dev_password@localhost:5432/agentos_db
DATABASE_URL_SYNC=postgresql://agentos:agentos_dev_password@localhost:5432/agentos_db

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Auth & Security
JWT_SECRET=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536

# API
API_HOST=0.0.0.0
API_PORT=8000
API_TITLE=AgentOS API
API_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM Provider (OpenAI)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4

# Worker Configuration
WORKER_ID=worker-1
WORKER_CONCURRENCY=5
WORKER_TASK_TIMEOUT_SECONDS=300
WORKER_LEASE_DURATION_SECONDS=60

# Scheduler Configuration
SCHEDULER_INTERVAL_SECONDS=30
SCHEDULER_BATCH_SIZE=100

# Execution Configuration
DEFAULT_NODE_TIMEOUT_SECONDS=300
DEFAULT_WORKFLOW_TIMEOUT_SECONDS=3600
DEFAULT_MAX_RETRIES=3
DEFAULT_RETRY_BACKOFF_MULTIPLIER=2.0

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_METRICS_PORT=8001

# Feature Flags
ENABLE_AGENT_SYSTEM=true
ENABLE_APPROVAL_NODES=true
ENABLE_MEMORY_PERSISTENCE=true
